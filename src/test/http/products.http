### 실행 전 확인
# 1. local 프로필로 애플리케이션을 실행합니다.
# 2. 로컬 DB에 아래 category와 productTier에 해당하는 상품이 있어야 합니다.
# 3. X-Product-Tier는 로그인 기능 완성 전 local 프로필에서만 사용하는 인증 헤더입니다.
# 4. 목록 조회를 먼저 실행하면 첫 상품 ID가 상세조회 요청에 자동으로 저장됩니다.

@host = http://localhost:8080
@memberTier = RED
@category = Guns
@productTier = red

### 상품 목록 조회
GET {{host}}/api/products?category={{category}}&tier={{productTier}}&sort=POPULAR&page=0&size=100
Accept: application/json
X-Product-Tier: {{memberTier}}

> {%
    client.test("상품 목록을 조회한다", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이 아닙니다.");
        client.assert(response.body.code === "SUCCESS", "응답 코드가 SUCCESS가 아닙니다.");
        client.assert(Array.isArray(response.body.data.items), "상품 목록 형식이 아닙니다.");
        client.assert(response.body.data.items.length > 0, "조회된 상품이 없습니다.");
    });

    const items = response.body.data.items;
    if (items.length > 0) {
        client.global.set("productId", items[0].id);
    }
%}

### 상품 상세조회 - 위 목록에서 조회된 첫 상품 ID 사용
GET {{host}}/api/products/{{productId}}
Accept: application/json
X-Product-Tier: {{memberTier}}

> {%
    client.test("상품 상세정보를 조회한다", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이 아닙니다.");
        client.assert(response.body.code === "SUCCESS", "응답 코드가 SUCCESS가 아닙니다.");
        client.assert(response.body.data.id !== null, "상품 ID가 없습니다.");
        client.assert(response.body.data.productCode, "상품 코드가 없습니다.");
        client.assert(response.body.data.name, "상품명이 없습니다.");
        client.assert(response.body.data.imageUrl, "상품 이미지 URL이 없습니다.");

        const specs = response.body.data.specs;
        client.assert(Array.isArray(specs), "상품 제원 형식이 아닙니다.");
        client.assert(specs.length > 0, "상품 제원이 비어 있습니다.");

        specs.forEach(function (spec, index) {
            client.assert(spec.name, index + "번째 상품 제원명이 없습니다.");
            client.assert(spec.value, index + "번째 상품 제원값이 없습니다.");
            client.assert(
                Number.isInteger(spec.sortOrder),
                index + "번째 상품 제원 정렬 순서가 없습니다."
            );
        });
    });
%}
