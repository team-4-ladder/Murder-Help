PATCH {{host}}/api/chat/rooms/{{ROOM_ID}}/close
Authorization: Bearer {{ADMIN_TOKEN}}

> {%
  client.log("[종료 ✅ 관리자] status: " + response.status);
  client.log("응답: " + JSON.stringify(response.body));
%}

###

### ❌ 인가 거부 — YELLOW 고객(김쩌리)이 이성조 방 종료 시도 → 403
PATCH {{host}}/api/chat/rooms/{{ROOM_ID}}/close
Authorization: Bearer {{OTHER_CUSTOMER_TOKEN}}

> {%
  client.log("[종료 ❌ 타인 차단] status: " + response.status + " | 기대: 403");
  client.log("응답: " + JSON.stringify(response.body));
%}

###

### ❌ 인증 없음 → 401
PATCH {{host}}/api/chat/rooms/{{ROOM_ID}}/close

> {%
  client.log("[종료 ❌ 미인증] status: " + response.status + " | 기대: 401");
  client.log("응답: " + JSON.stringify(response.body));
%}


