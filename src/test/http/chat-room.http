POST {{host}}/api/chat/rooms/cache/recover
Authorization: Bearer {{CUSTOMER_TOKEN}}

> {%
  client.log("[캐시 복구 ❌ 고객 차단] status: " + response.status + " | 기대: 403");
  client.log("응답: " + JSON.stringify(response.body));
