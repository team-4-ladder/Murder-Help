
@host = http://localhost:8080
@email = ptjkjm1@gmail.com
@password = test1234

### 로그인 - 실제 JWT Access Token 발급
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("로그인하고 Access Token을 발급받는다", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이 아닙니다.");
        client.assert(response.body.code === "SUCCESS", "응답 코드가 SUCCESS가 아닙니다.");
        client.assert(response.body.data.accessToken, "Access Token이 없습니다.");
    });

    client.global.set("accessToken", response.body.data.accessToken);
%}

### 주문 목록 조회
GET {{host}}/api/orders
Accept: application/json
Authorization: Bearer {{accessToken}}